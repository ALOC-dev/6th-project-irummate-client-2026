# 키 이름만 둔다. 실제 값은 커밋하지 않는 .env에 넣는다.

# API 주소. 비우면 같은 출처의 /api를 쓴다(개발 서버 프록시·Vercel 리라이트).
VITE_API_BASE_URL=
# 개발 서버가 /api를 넘길 백엔드 주소
VITE_API_PROXY_TARGET=

# 카카오 로그인
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=

# 개발 모드에서 MSW 가짜 서버를 켤지 (true / 비움)
VITE_ENABLE_MSW=

# MY 화면 문의용 오픈채팅 주소
VITE_INQUIRY_OPENCHAT_URL=

# 채팅 소켓 주소 (B)
VITE_SOCKET_URL=

# gen:api가 읽을 백엔드 OpenAPI 문서 주소
OPENAPI_URL=
